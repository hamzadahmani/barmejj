    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.3.0",
    "@types/react-native-modern-datepicker": "^1.0.5",
    "@types/react-test-renderer": "19.3.0",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
