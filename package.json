{
  "name": "Barmej",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "api:local": "node scripts/set-api-mode.js local",
    "api:online": "node scripts/set-api-mode.js online",
    "android": "npm run api:local && scripts\\run-android.cmd",
    "android:metro": "npm run api:local && react-native start",
    "build:android:debug": "npm run api:online && scripts\\build-android-debug.cmd",
    "build:android:release": "npm run api:online && scripts\\build-android-release.cmd",
    "postinstall": "node scripts/apply-compatibility-fixes.cjs",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "e2e:maestro": "maestro test .maestro/flows",
    "check": "npm run lint && tsc --noEmit && npm test -- --runInBand --passWithNoTests"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
